{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exdesigner/schemas/ruleset.schema.json",
  "title": "Derating rule set",
  "type": "object",
  "required": ["id", "version", "rules"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "source": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "part_class", "param", "rating", "factor", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "part_class": { "type": "string" },
          "subtype": { "type": ["string", "null"] },
          "param": { "type": "string", "description": "stress parameter name, e.g. v_dc, i_rms, p_loss, tj" },
          "rating": { "type": "string", "description": "rating name, e.g. v_rated, i_rated, p_rated, tj_max" },
          "factor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.5 },
          "offset": { "type": "number", "description": "limit = factor*rating + offset (e.g. Tj <= Tjmax - 25)" },
          "curve": {
            "type": "object",
            "description": "temperature-dependent power derating: linear from full at t_knee to zero at t_max",
            "required": ["t_knee", "t_max"],
            "additionalProperties": false,
            "properties": {
              "t_knee": { "type": "string", "description": "rating name holding the knee temperature" },
              "t_max": { "type": "string", "description": "rating name holding the max temperature" }
            }
          },
          "source": { "type": "string" },
          "verify": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
