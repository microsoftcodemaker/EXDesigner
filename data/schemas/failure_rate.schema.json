{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exdesigner/schemas/failure_rate.schema.json",
  "title": "Failure-rate table (parts-stress constant-rate method or PoF Weibull roll-up)",
  "type": "object",
  "required": ["id", "method", "version", "source", "confidence"],
  "additionalProperties": false,
  "$defs": {
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "curve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number" }
      }
    },
    "factor": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["constant", "lookup", "arrhenius", "stress_ratio", "value_curve"]
        },
        "value": { "type": "number" },
        "by": { "type": "string" },
        "table": { "type": "object", "additionalProperties": { "type": "number" } },
        "default": { "type": "number" },
        "ea_ev": { "type": "number", "minimum": 0, "maximum": 3 },
        "t_ref_c": { "type": "number" },
        "requires_tj": { "type": "boolean" },
        "param": { "type": "string" },
        "rating": { "type": "string" },
        "curve": { "$ref": "#/$defs/curve" },
        "log": { "type": "boolean" },
        "note": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "constant" } } }, "then": { "required": ["value"] } },
        { "if": { "properties": { "kind": { "const": "lookup" } } }, "then": { "required": ["by", "table"] } },
        { "if": { "properties": { "kind": { "const": "arrhenius" } } }, "then": { "required": ["ea_ev"] } },
        { "if": { "properties": { "kind": { "const": "stress_ratio" } } }, "then": { "required": ["param", "rating", "curve"] } },
        { "if": { "properties": { "kind": { "const": "value_curve" } } }, "then": { "required": ["curve"] } }
      ]
    },
    "entry": {
      "type": "object",
      "required": ["factors"],
      "additionalProperties": false,
      "properties": {
        "form": { "type": "string", "enum": ["product", "ic_sum"] },
        "lambda_b": { "type": "number", "minimum": 0 },
        "c1": { "type": "number", "minimum": 0 },
        "c2": { "type": "number", "minimum": 0 },
        "factors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/factor" } },
        "source": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "method": { "type": "string", "enum": ["parts_stress", "pof_weibull"] },
    "version": { "type": "integer", "minimum": 1 },
    "standard": { "type": "string" },
    "description": { "type": "string" },
    "source": { "type": "string" },
    "license": { "type": "string" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "rate_unit": { "type": "string", "enum": ["fit", "per_1e6_h"] },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": { "type": "string" },
        "quality": { "type": "string" },
        "kb_ev_per_k": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/entry" }
      }
    },
    "life_is": { "type": "string", "enum": ["eta", "b10"] },
    "default_beta": { "type": "number", "exclusiveMinimum": 0 },
    "mechanisms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["beta"],
        "additionalProperties": false,
        "properties": {
          "beta": { "type": "number", "exclusiveMinimum": 0 },
          "source": { "type": "string" }
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "t_min_h": { "type": "number", "exclusiveMinimum": 0 },
        "points": { "type": "integer", "minimum": 16, "maximum": 5000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "method": { "const": "parts_stress" } } },
      "then": { "required": ["rate_unit", "classes"] }
    },
    {
      "if": { "properties": { "method": { "const": "pof_weibull" } } },
      "then": { "required": ["mechanisms", "default_beta"] }
    }
  ]
}
